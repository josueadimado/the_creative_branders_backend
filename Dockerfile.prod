# Production image: gunicorn only, no compilers or local-dev tools.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=config.settings.production

WORKDIR /app

# Copy both files: production.txt includes "-r base.txt".
COPY requirements/base.txt requirements/production.txt /app/requirements/
RUN pip install --no-cache-dir -r requirements/production.txt

COPY . .

# Create a non-root user and give it ownership of the app directory
# (needed so collectstatic can write into /app/staticfiles at startup).
RUN addgroup --system django \
    && adduser --system --ingroup django django \
    && mkdir -p /app/staticfiles \
    && chown -R django:django /app

USER django

EXPOSE 8000
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "120"]
