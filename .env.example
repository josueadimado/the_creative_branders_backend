# Copy this file to .env and keep .env private (it is git-ignored).
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=dev-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Use either DATABASE_URL *or* the discrete POSTGRES_* variables below.
# If none of these are set, development settings fall back to a local SQLite file.
DATABASE_URL=postgres://tcb:tcb@db:5432/tcb
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=tcb
POSTGRES_USER=tcb
POSTGRES_PASSWORD=tcb

# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

# Lead notifications (optional locally — without these, emails print to the console).
# Visitors see hello@ on the site. Form alerts go to this inbox.
STUDIO_NOTIFY_EMAIL=you@example.com
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=The Creative Branders <hello@thecreativebranders.com>
# Or use any SMTP instead of Resend:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Desk Analytics traffic (optional). Leave blank to keep “GA4 disconnected” + sample traffic.
# 1) GA4 Admin → Property settings → copy the numeric Property ID
# 2) Google Cloud → create a service account → download JSON key
# 3) GA4 Admin → Property access management → add the service account email as Viewer
# GA4_PROPERTY_ID=123456789
# GA4_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
