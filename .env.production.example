# Copy these into the Dokploy Environment screen for the backend project.
# Do not commit a filled-in copy. The values below are placeholders.

# Which settings file Django loads. Leave this line as it is.
DJANGO_SETTINGS_MODULE=config.settings.production

# A long random string. Django uses it to sign logins.
# Generate one on your computer:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value

# The live server never shows error pages with code in them.
DEBUG=False

# The only hostname allowed to talk to Django. This is the API domain.
ALLOWED_HOSTS=api.thecreativebranders.com

# Postgres. The compose file sets POSTGRES_HOST to the db container.
# Pick your own user, password, and database name.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=tcb
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me

# Websites allowed to call this API from a browser.
CORS_ALLOWED_ORIGINS=https://thecreativebranders.com,https://www.thecreativebranders.com

# Websites allowed to submit the Django admin login.
# The API host is included because the content desk is served from that host.
CSRF_TRUSTED_ORIGINS=https://api.thecreativebranders.com,https://thecreativebranders.com,https://www.thecreativebranders.com

# Public addresses used in emails and links.
FRONTEND_URL=https://thecreativebranders.com
BACKEND_PUBLIC_URL=https://api.thecreativebranders.com

# Where a new project brief is emailed.
STUDIO_NOTIFY_EMAIL=thecreativebranders@gmail.com

# Resend API key (https://resend.com). Leave the placeholder until you create a key.
# Without a real key, the site still runs and mail is printed in the container log.
RESEND_API_KEY=re_xxxxxxxx

# The From address on outgoing mail. This inbox must be allowed in Resend.
DEFAULT_FROM_EMAIL=hello@thecreativebranders.com
