# Copy this file to .env on the production host and fill in real values.
# Dokploy writes these into .env beside docker-compose.prod.yml.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me-to-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=api.thecreativebranders.com

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=tcb
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me

# Optional alternative to the POSTGRES_* block above:
# DATABASE_URL=postgres://USER:PASSWORD@db:5432/tcb

# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=https://thecreativebranders.com,https://www.thecreativebranders.com

# Needed so the Django admin works behind HTTPS (Caddy on the host).
CSRF_TRUSTED_ORIGINS=https://api.thecreativebranders.com,https://thecreativebranders.com,https://www.thecreativebranders.com

FRONTEND_URL=https://www.thecreativebranders.com
BACKEND_PUBLIC_URL=https://api.thecreativebranders.com

# Lead notifications — Resend (https://resend.com). Studio inbox gets every form.
STUDIO_NOTIFY_EMAIL=hello@thecreativebranders.com
RESEND_API_KEY=re_xxxxxxxx
DEFAULT_FROM_EMAIL=The Creative Branders <hello@thecreativebranders.com>
